{
  "name": "cc-memory-viewer-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,ui \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "vite --port 3415",
    "client": "vite --port 3415",
    "server": "bun --watch server/index.ts",
    "build": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && vite build",
    "build:server": "bun build server/index.ts --target=bun --outdir dist/server",
    "build:client": "vite build",
    "preview": "vite preview --port 3415",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "bun ./node_modules/.bin/oxlint 2>&1 | head -n 200",
    "fmt": "bun ./node_modules/.bin/oxfmt .",
    "fmt:check": "bun ./node_modules/.bin/oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run fmt:check && bun run typecheck && vitest run --coverage"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "helmet": "^7.1.0",
    "mermaid": "^10.9.0",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.23.1",
    "remark-gfm": "^4.0.0",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0",
    "zod": "^3.23.8",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-query-devtools": "^5.60.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "jsdom": "^24.1.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}

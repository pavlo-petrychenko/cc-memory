{
  "name": "cc-memory-viewer-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run server\" \"bun run client\"",
    "client": "vite --port 3415",
    "server": "bun --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3415"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^10.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.23.1",
    "remark-gfm": "^4.0.0",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}

{
  "name": "vault-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run server:dev\" \"bun run client:dev\"",
    "client:dev": "vite --port 3413 --host 0.0.0.0",
    "server:dev": "bun --watch server/index.ts",
    "server:start": "bun server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3413"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.23.1",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^7.0.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^10.9.1",
    "chokidar": "^4.0.1",
    "yaml": "^2.9.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  }
}

{
  "name": "vault-viewer-obsidian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts --port 3414 --host 0.0.0.0",
    "build": "vite build --config client/vite.config.ts && tsc --noEmit --project client/tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "bun server/src/index.ts",
    "typecheck": "tsc --noEmit --project client/tsconfig.json"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "chokidar": "4.0.3",
    "gray-matter": "4.0.3",
    "yaml": "2.9.0",
    "smol-toml": "1.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.4",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "8.2.2",
    "playwright": "1.62.1",
    "typescript": "5.7.3",
    "vite": "5.4.11"
  }
}

{
  "name": "cc-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent, layered, per-workspace memory for Claude Code",
  "type": "module",
  "scripts": {
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test --coverage",
    "fmt": "bun ./node_modules/.bin/oxfmt .",
    "fmt:check": "bun ./node_modules/.bin/oxfmt --check .",
    "lint": "bun ./node_modules/.bin/oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli/main.ts --target=bun --outfile dist/memory.js",
    "build:app": "npm --prefix app/web run build",
    "build:all": "bun run build && bun run build:app",
    "dev:web": "npm --prefix app/web run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "serve": "bun run dist/memory.js serve"
  },
  "dependencies": {
    "express": "^4.21.0",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "1.3.14",
    "@types/express": "^4.17.21",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
